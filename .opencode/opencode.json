{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "**/.env", "effect": "deny" }
  ],
  "instructions": ["AGENTS.md", "my-workflows.md"],
  "skills": [".opencode/skills"],
  "mcp": {
    "servers": {
      "godot": {
        "type": "local",
        "command": ["uv", "run", "--directory", ".", "godot-editor-mcp"],
        "cwd": ".",
        "timeout": {
          "startup": 30000,
          "catalog": 30000,
          "execution": 120000
        }
      }
    }
  },
  "references": {
    "godot-agents": {
      "path": "../godot-agents",
      "description": "The agent orchestrator that consumes this server's MCP tool surface. godot-agents pins godot-mcp's exact tool names, param keys, toolset categories, and response envelope. Consult it as a downstream consumer when a tool/param/envelope change might break callers, or when checking how a tool is actually invoked in practice."
    }
  },
  "watcher": {
    "ignore": [
      "graphify-out/**",
      ".venv/**",
      "godot/.godot/**",
      "uv.lock",
      "node_modules/**"
    ]
  }
}
