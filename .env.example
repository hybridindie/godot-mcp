# opencode harness (optional opt-ins)
#
# Built-in websearch (Exa-hosted, no API key needed). Off by default; uncomment
# and export before launching opencode to give the agent web search alongside
# Context7 (which is library-docs-only). Useful for Godot API quirks, error
# messages, and version migrations not in any library's docs.
#   source .env  (or: set -a; . ./.env; set +a)
#   opencode
# OPENCODE_ENABLE_EXA=1

# Experimental LSP tool — go-to-def / find-references / hover via configured LSP
# servers. Opt-in only; it's experimental and not required for any workflow.
# OPENCODE_EXPERIMENTAL_LSP_TOOL=true