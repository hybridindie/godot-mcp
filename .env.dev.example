# .env.dev.example — developer environment
#
# Copy to .env (gitignored) for local development. Includes everything in
# .env.example plus graphify/ollama config for the knowledge graph and
# opencode opt-ins. End users don't need this — use .env.example instead.
#
# Source before running graphify or launching opencode:
#   set -a; . ./.env; set +a

# ═══════════════════════════════════════════════════════════════════════
# Server config (same as .env.example — uncomment to override defaults)
# ═══════════════════════════════════════════════════════════════════════
# GODOT_MCP_TRANSPORT=stdio
# GODOT_MCP_BRIDGE_URL=ws://127.0.0.1:9080
# GODOT_MCP_GODOT_BIN=/Applications/Godot.app/Contents/MacOS/Godot
# GODOT_MCP_PROJECT_DIR=./examples/survivors

# ═══════════════════════════════════════════════════════════════════════
# Graphify LLM backend (developers only — for the knowledge graph)
#
# POLICY: local ollama only — no cloud models. Do NOT add OPENAI_*/ANTHROPIC_*/
# GEMINI_* keys: graphify's detect_backend() prefers cloud keys over ollama.
# ═══════════════════════════════════════════════════════════════════════
# Local Ollama (runs on localhost:11434).
# On Apple Silicon prefer the MLX build (faster) — pull with `ollama pull qwen3.8:27b-mlx`.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.8:27b-mlx
OLLAMA_API_KEY=ollama
GRAPHIFY_OLLAMA_KEEP_ALIVE=30m
# Reasoning models (Qwen3 family) think before answering — the thinking phase
# consumes output budget, so keep this generous or labels come back empty.
GRAPHIFY_MAX_OUTPUT_TOKENS=8192

# ═══════════════════════════════════════════════════════════════════════
# opencode opt-ins (optional)
# ═══════════════════════════════════════════════════════════════════════
# Built-in websearch (Exa-hosted, no API key needed). Off by default.
# OPENCODE_ENABLE_EXA=1
# Experimental LSP tool — go-to-def / find-references / hover.
# OPENCODE_EXPERIMENTAL_LSP_TOOL=true